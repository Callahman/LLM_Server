# Tower Mumble pipeline configuration
# Copy to .env and fill in YOUR real values. The values below are
# stand-in placeholders — replace them with your own before deploying.

# --- Mumble (the Pi's murmurd, via LAN or Tailscale) ---
# The Pi's LAN IP (at home) or its Tailscale hostname (away),
# e.g. rpi-xxxx.ts.net
MUMBLE_HOST=192.168.1.50
MUMBLE_PORT=64738
MUMBLE_USER=tower-bot
MUMBLE_PASSWORD=
# Name of the channel to join
TARGET_CHANNEL=Home
# Optional client certificate (persistent bot identity)
# MUMBLE_CERT=
# MUMBLE_KEY=

# --- Whisper ---
# Model size: tiny, base, small, medium, large
# base = fastest, small = recommended (best accuracy/latency balance for a
# casual pipeline), medium = most accurate and slowest on CPU
WHISPER_MODEL_SIZE=small
# Language of the speakers (ISO 639-1 code). Setting this skips
# per-utterance language detection, which is unreliable on short, noisy
# clips and hurts accuracy.
WHISPER_LANGUAGE=en
# Utterances whose no_speech_prob exceeds this are treated as silence
# (no LLM reply). Raise to be more aggressive about dropping noise.
NO_SPEECH_PROB_MAX=0.6
# Utterances whose avg_logprob is below this are treated as too unreliable
# to reply to. Lower (e.g. -1.5) to keep more marginal transcripts.
AVG_LOGPROB_MIN=-1.0
# Trim leading/trailing silence with Silero VAD before transcribing
# (1 = on, 0 = off). Downloads the VAD model on first run.
WHISPER_VAD_FILTER=1

# --- Ollama ---
# Base URL of the Ollama instance (no trailing /v1 — the code appends it)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag exactly as shown by `ollama list`
OLLAMA_MODEL=qwen3.5:latest
# System prompt sent to the LLM
LLM_SYSTEM_PROMPT=You are a helpful assistant. Answer the user's question or comment.
# Retries for LLM calls
MAX_RETRIES=3

# --- Code-execution harness (optional) ---
# Wrap the LLM with smolagents CodeAgent: the model can write and run Python
# in a Docker-sandboxed container confined to SANDBOX_DIR (no network,
# 512 MB RAM, 1 CPU). Requires Docker on the tower (see SETUP.md §6.1).
# 1 = on, 0 = off (plain single-shot LLM)
LLM_HARNESS=1
# Dedicated directory the sandbox can read/write (bind-mounted into the
# container at /workspace). Keep it outside the code tree.
SANDBOX_DIR=~/llm_server/sandbox
# Max agent steps (code-gen -> run -> observe) per user message
HARNESS_MAX_STEPS=6
# Wall-clock timeout (s) for a harness run; on timeout the container is
# killed and the message falls back to the plain LLM
HARNESS_TIMEOUT_SECONDS=300

# --- Utterance detection (voice) ---
# RMS energy threshold (16-bit scale): raise if the bot triggers on
# background noise, lower if it misses quiet speech
AUDIO_RMS_THRESHOLD=400
# Silence gap (ms) that ends an utterance
SILENCE_MS=700
# Max utterance length (ms) before it is force-ended
MAX_UTTERANCE_MS=30000
# Utterances shorter than this (ms) are dropped
MIN_UTTERANCE_MS=300

# --- Audio archive ---
# A copy of each processed utterance WAV is archived here
AUDIO_ARCHIVE_DIR=~/llm_server/archive
# Max size (GB) to retain in the archive; older files are deleted
AUDIO_RETENTION_GB=5

# --- Keep-awake (tower idle-shutdown integration) ---
# Directory where the tower's idle-shutdown script checks for lockfiles.
# The systemd service sets RuntimeDirectory=keep-awake.d so the directory
# is owned by the service user.
KEEP_AWAKE_DIR=/var/run/keep-awake.d
# Grace period (seconds) after the last user leaves before the lockfile
# is removed.
KEEP_AWAKE_GRACE_SECONDS=300

# --- Logging ---
LOG_DIR=~/llm_server/logs
