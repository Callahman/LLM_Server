# Tower Mumble pipeline configuration
# Copy to .env. Defaults carried over from the old Discord tower .env.example
# where applicable.

# --- Mumble (the Pi's murmurd, via LAN or Tailscale) ---
# The Pi's LAN IP (at home) or its Tailscale hostname (away),
# e.g. rpi-xxxx.ts.net
MUMBLE_HOST=10.0.0.11
MUMBLE_PORT=64738
MUMBLE_USER=tower-bot
MUMBLE_PASSWORD=
# Name of the channel to join
TARGET_CHANNEL=Home
# Optional client certificate (persistent bot identity)
# MUMBLE_CERT=
# MUMBLE_KEY=

# --- Whisper ---
# Model size: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# --- Ollama ---
# Base URL of the Ollama instance (no trailing /v1 — the code appends it)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag exactly as shown by `ollama list`
OLLAMA_MODEL=qwen3.5:latest
# System prompt sent to the LLM
LLM_SYSTEM_PROMPT=You are a helpful assistant. Answer the user's question or comment.
# Retries for LLM calls
MAX_RETRIES=3

# --- Utterance detection (voice) ---
# RMS energy threshold (16-bit scale): raise if the bot triggers on
# background noise, lower if it misses quiet speech
AUDIO_RMS_THRESHOLD=400
# Silence gap (ms) that ends an utterance
SILENCE_MS=700
# Max utterance length (ms) before it is force-ended
MAX_UTTERANCE_MS=30000
# Utterances shorter than this (ms) are dropped
MIN_UTTERANCE_MS=300

# --- Audio archive ---
# A copy of each processed utterance WAV is archived here
AUDIO_ARCHIVE_DIR=~/mumble_listener/archive
# Max size (GB) to retain in the archive; older files are deleted
AUDIO_RETENTION_GB=5

# --- Keep-awake (tower idle-shutdown integration) ---
# Directory where the tower's idle-shutdown script checks for lockfiles.
# The systemd service sets RuntimeDirectory=keep-awake.d so the directory
# is owned by the service user.
KEEP_AWAKE_DIR=/var/run/keep-awake.d
# Grace period (seconds) after the last user leaves before the lockfile
# is removed.
KEEP_AWAKE_GRACE_SECONDS=300

# --- Logging ---
LOG_DIR=~/mumble_listener/logs
