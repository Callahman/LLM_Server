# Pi Mumble trigger configuration
# Copy to .env and fill in YOUR real values. The values below are
# stand-in placeholders — replace them with your own before deploying.

# --- Mumble (local murmurd on the Pi) ---
MUMBLE_HOST=127.0.0.1
MUMBLE_PORT=64738
MUMBLE_USER=pi-trigger
MUMBLE_PASSWORD=
# Name of the channel to watch for presence/text
TARGET_CHANNEL=Home

# --- Tower (remote server) ---
# Your tower's LAN IP (or Tailscale hostname)
TOWER_HOST=192.168.1.100
# Your tower's NIC MAC address (for Wake-on-LAN)
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# SSH user on the tower
TOWER_SSH_USER=your-username
# Path to the SSH private key on the Pi
TOWER_SSH_KEY=~/.ssh/id_ed25519

# --- Behavior ---
# Max seconds to wait for the tower to come up after WOL
WOL_WAIT_SECONDS=300
# Idle grace period before closing the SSH keepalive
GRACE_SECONDS=300
# How often to poll channel presence (seconds)
PRESENCE_POLL_SECONDS=5
# 1 = post "waking up" / "going idle" status in the channel
POST_STATUS=1
# Comma-separated usernames whose text messages must NOT trigger WOL
IGNORE_USER=tower-bot
