[Unit]
Description=Mumble trigger (Wake-on-LAN + SSH keepalive for the tower)
After=network-online.target mumble-server.service
Wants=network-online.target

[Service]
# Set to the Linux user that runs the service (the user that owns
# /opt/mumble-listener/pi and whose SSH key is used for the tower).
User=pi
Type=simple
WorkingDirectory=/opt/mumble-listener/pi
ExecStart=/opt/mumble-listener/pi/.venv/bin/python trigger.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
